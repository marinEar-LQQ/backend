{
  "name": "marinear-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "marinEar 브라우저 로컬 분석 엔진 (Web Worker)",
  "scripts": {
    "typecheck": "tsc -p tsconfig.test.json",
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "harness": "vite"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.6.3",
    "vite": "6.4.5",
    "vitest": "^2.1.8"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./worker": {
      "types": "./dist/workers/engine.worker.d.ts",
      "default": "./dist/workers/engine.worker.js"
    }
  },
  "files": [
    "dist",
    "src",
    "fixtures"
  ],
  "dependencies": {
    "@huggingface/transformers": "4.3.2"
  }
}
